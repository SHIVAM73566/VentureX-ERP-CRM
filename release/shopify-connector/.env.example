# VentureX Shopify Connector - Environment Template
# Copy this file to .env in your app root and fill in values.

# Your self-hosted VentureX ERP base API URL (no trailing slash)
VENTUREX_API_URL=https://your-domain.com/api

# API token generated in VentureX: Settings > API > Generate Token
VENTUREX_API_TOKEN=

# Shopify dev store used while testing (auto-set by shopify CLI)
SHOPIFY_DEV_STORE=venturex-demo.myshopify.com

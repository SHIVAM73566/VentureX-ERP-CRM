# VentureX ERP & CRM — PROJECT ROOT .htaccess (fallback only)
#
# PREFERRED DEPLOYMENT: point the web server document root directly at /public.
# In that configuration, public/.htaccess is the only rewrite file in use and
# this file is never read by Apache.
#
# If your host absolutely cannot change the document root, this file may be
# used as a fallback: it blocks sensitive paths and forwards the first request
# pass into public/. The REDIRECT_STATUS guard prevents an internal loop.
# Always prefer /public as the document root over using this fallback.

Options -Indexes

# Deny direct access to environment, credential, backup and VCS files.
<FilesMatch "^(?:\.env(?:\..*)?|\.htaccess|\.htpasswd|\.git|\.gitignore|\.gitattributes|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit(?:\.mysql)?\.xml|.*\.(?:sql|bak|old|log|ini|sh))$">
    Require all denied
</FilesMatch>

# Common hidden files and well-known metadata.
<FilesMatch "^\.(?!well-known$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block sensitive directories before any fallback routing.
    RewriteRule ^(?:\.git|\.github|\.idea|\.vscode|app|bootstrap|config|database|docker|documentation|node_modules|release|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Root-document-root fallback only. The REDIRECT_STATUS condition ensures
    # this runs on the original external request, not after public/.htaccess
    # has already taken over. Remove this block when /public is the document root.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

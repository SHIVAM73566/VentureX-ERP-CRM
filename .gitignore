# Environment and secrets
.env
.env.*
!.env.example
auth.json

# Databases and dumps
*.sql
*.sql.gz
*.sqlite
*.sqlite3
database/database.sqlite

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
storage/*.key

# Installer state
/storage/.installed

# Dependencies and generated files
/node_modules
/vendor
/.phpunit.cache
/.phpunit.result.cache
.phpactor.json
_ide_helper.php
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Laravel runtime caches and storage
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# Release binaries are never tracked; listing documents are trackable.
*.zip
!release/*.md
!release/*.txt
!release/*.html

# Editor / OS files
.DS_Store
Thumbs.db
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed

*.log

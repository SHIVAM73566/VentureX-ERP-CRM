# =====================================================
# VentureX ERP & CRM — Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =====================================================

APP_NAME="VentureX ERP & CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

# MFA Enforcement — set to true in production, false for demo/development
MFA_ENFORCE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: set to 'daily' stack and LOG_LEVEL=warning
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=VENTUREX_ERP
DB_USERNAME=VENTUREX_ERP_user
DB_PASSWORD=your_database_password

# MySQL SSL (production) — set path to your CA certificate
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE=null
SESSION_SAMESITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Gateway (backend-only, env-secured) ---
# Customers are responsible for configuring and paying for third-party API services.
# Set keys in the deployment environment. NEVER commit real values.

# Primary AI provider: swift, gemini, deepseek, nvidia, claude
AI_PROVIDER=nvidia
AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
AI_DEFAULT_PROVIDER=nvidia
AI_CACHE_TTL_HOURS=24
AI_REQUEST_TIMEOUT=60
AI_FALLBACK_ORDER=gemini,deepseek

# API Keys (all optional — ERP works without AI configured)
RAPIDAPI_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Swift AI (RapidAPI)
SWIFT_AI_HOST=swift-ai.p.rapidapi.com
SWIFT_AI_PATH=/chat/completions
SWIFT_AI_MODEL=gpt-5
SWIFT_AI_ENDPOINT=https://swift-ai.p.rapidapi.com/chat/completions

# Gemini (RapidAPI)
GEMINI_AI_HOST=gemini-3-5-flash.p.rapidapi.com
GEMINI_AI_PATH=/chat/completions
GEMINI_AI_MODEL=gemini-3.5-flash
GEMINI_AI_ENDPOINT=https://gemini-3-5-flash.p.rapidapi.com/chat/completions
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_TEMPERATURE=0.4
# GEMINI_TOP_P=0.9
# GEMINI_MAX_OUTPUT_TOKENS=2048

# DeepSeek (RapidAPI)
DEEPSEEK_AI_HOST=deepseek-v31.p.rapidapi.com
DEEPSEEK_AI_PATH=/
DEEPSEEK_AI_MODEL=DeepSeek-V3.2
DEEPSEEK_AI_ENDPOINT=https://deepseek-v31.p.rapidapi.com/
# OPENAI_TEMPERATURE=0.4

# Claude (specialist provider, via RapidAPI)
CLAUDE_RAPIDAPI_HOST=claude-3-5-sonnet.p.rapidapi.com
CLAUDE_RAPIDAPI_ENDPOINT=https://claude-3-5-sonnet.p.rapidapi.com/
CLAUDE_MODEL=claude-3-5-sonnet
CLAUDE_RAPIDAPI_KEY=
AI_CLAUDE_MIN_IMPACT=70
# ANTHROPIC_TEMPERATURE=0.4

AI_TEMPERATURE=0.4
AI_TOP_P=0.9
AI_MAX_TOKENS=2048
AI_RETRIES=1
AI_DEDUP_LOCK_TTL=180

# Rate limiting (per hour / per day)
AI_RATE_MAX_USER_PER_HOUR=60
AI_RATE_MAX_USER_PER_DAY=200
AI_RATE_MAX_COMPANY_PER_HOUR=300

# Quota system toggle (false by default so fresh installs are not quota-blocked)
AI_QUOTA_ENABLED=false

# Provider-specific model overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Provider health: skip a provider after repeated failures within the window
AI_HEALTH_MAX_FAILURES=3
AI_HEALTH_WINDOW=600

# NVIDIA (OpenAI-compatible, bearer token)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# --- Optional integrations (leave blank if not used) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WHATSAPP_API_KEY=
# WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0

# --- Firebase (optional) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_AUTH_ENABLED=false
FIREBASE_FIRESTORE_ENABLED=false
FIREBASE_STORAGE_ENABLED=false
FIREBASE_MESSAGING_ENABLED=false
FIREBASE_ANALYTICS_ENABLED=false

# --- Security policy ---
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_PASSWORD_HISTORY=5
SECURITY_PASSWORD_EXPIRE_DAYS=90
SECURITY_PASSWORD_REVOKE_SESSIONS=true
SECURITY_LOCKDOWN_ACTIVE=false

# --- Login Protection ---
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=5
SECURITY_LOGIN_LOCKOUT_THRESHOLD=8
SECURITY_LOGIN_LOCKOUT_MINUTES=15
SECURITY_LOGIN_ALERT_AFTER=10

# --- AI Rate Limiting (per user) ---
SECURITY_AI_PER_MINUTE=10
SECURITY_AI_PER_HOUR=60
SECURITY_AI_PER_DAY=200

# --- Export Center ---
SECURITY_EXPORT_PER_DAY=20
SECURITY_EXPORT_MAX_RECORDS=25000
SECURITY_EXPORT_URL_MINUTES=30
SECURITY_EXPORT_MAX_DOWNLOADS=3

# --- Upload / File Scanning ---
SECURITY_UPLOAD_MAX_KB=10240

# VentureX ERP & CRM — Environment configuration
# Copy to .env and set values for your environment:
#   cp .env.example .env  (Linux/macOS) or copy manually on Windows
#
# Security: never commit .env. Keep API keys and secrets only in your server environment.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Human-readable application name (used in mails, page titles).
APP_NAME="VentureX ERP & CRM"
# Environment: local | staging | production | testing
APP_ENV=local
# Application encryption key (required). Generate with: php artisan key:generate
APP_KEY=
# Show debug errors (false in production).
APP_DEBUG=false
# Public base URL of the app (no trailing slash in practice).
APP_URL=http://localhost:8000
# Display/version string used by the app (informational).
APP_VERSION=1.0.0

# Web installer mode written by the installer wizard: production (clean install) or demo (sample/demo data).
INSTALL_MODE=production

# Enforce multi-factor authentication for eligible users (true in production recommended).
MFA_ENFORCE=false

# Locale settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode driver (file or database). When using database, configure CACHE/DB first.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Optional: number of PHP built-in server workers (dev only).
# PHP_CLI_SERVER_WORKERS=4

# Bcrypt cost factor (10–14 typical; higher is slower).
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Recommended production: set stack to include daily and use LOG_LEVEL=warning
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database (MySQL example)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=VENTUREX_ERP
DB_USERNAME=VENTUREX_ERP_user
DB_PASSWORD=your_database_password
# MySQL SSL CA certificate path (production), e.g. /etc/ssl/certs/ca-certificates.crt
# MYSQL_ATTR_SSL_CA=

# -----------------------------------------------------------------------------
# Sessions / broadcast / filesystem / cache / queue
# -----------------------------------------------------------------------------
# Use "file" for a fresh install: the sessions table does not exist until the
# one-time installer runs migrations. Switch to "database" after install if desired.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when served over HTTPS in production.
SESSION_SECURE=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue connection: sync | database | redis | etc. (see config/queue.php)
QUEUE_CONNECTION=database

# Cache store: file | database | redis | array (testing)
# "file" works before migrations (the cache table does not exist yet).
CACHE_STORE=file
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Redis (optional)
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS S3 (optional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AI Gateway (backend-only). App can run without AI keys; features degrade gracefully.
# Customers/providers are responsible for third-party API costs and terms.
# -----------------------------------------------------------------------------
# Primary provider hint: swift | gemini | deepseek | nvidia | claude (implementation-dependent)
AI_PROVIDER=nvidia
AI_MODEL=nvidia/nemotron-3.5-bolt-e4b
AI_DEFAULT_PROVIDER=nvidia
AI_CACHE_TTL_HOURS=24
AI_REQUEST_TIMEOUT=60
AI_FALLBACK_ORDER=gemini,deepseek

# API keys (leave empty if not used). Never commit real keys.
RAPIDAPI_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Swift AI (RapidAPI)
SWIFT_AI_HOST=swift-ai.p.rapidapi.com
SWIFT_AI_PATH=/chat/completions
SWIFT_AI_MODEL=gpt-5
SWIFT_AI_ENDPOINT=https://swift-ai.p.rapidapi.com/chat/completions

# Gemini (Google Generative Language API)
GEMINI_AI_HOST=generativelanguage.googleapis.com
GEMINI_AI_PATH=/v1beta/models/{model}:generateContent
GEMINI_AI_MODEL=gemini-3.5-flash-lite
GEMINI_AI_ENDPOINT=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TEMPERATURE=0.4
# GEMINI_TOP_P=0.9
# GEMINI_MAX_OUTPUT_TOKENS=2048

# DeepSeek (RapidAPI)
DEEPSEEK_AI_HOST=deepseek-v31.p.rapidapi.com
DEEPSEEK_AI_PATH=/
DEEPSEEK_AI_MODEL=DeepSeek-V3.2
DEEPSEEK_AI_ENDPOINT=https://deepseek-v31.p.rapidapi.com/
# OPENAI_TEMPERATURE=0.4

# Claude specialist via RapidAPI (optional)
CLAUDE_RAPIDAPI_HOST=claude-3-5-sonnet.p.rapidapi.com
CLAUDE_RAPIDAPI_ENDPOINT=https://claude-3-5-sonnet.p.rapidapi.com/
CLAUDE_MODEL=claude-3-5-sonnet
CLAUDE_RAPIDAPI_KEY=
AI_CLAUDE_MIN_IMPACT=70
# ANTHROPIC_TEMPERATURE=0.4

# Shared AI sampling/limits
AI_TEMPERATURE=0.4
AI_TOP_P=0.9
AI_MAX_TOKENS=2048
AI_RETRIES=1
AI_DEDUP_LOCK_TTL=180

# Rate limits (per user/company, rolling windows as implemented)
AI_RATE_MAX_USER_PER_HOUR=60
AI_RATE_MAX_USER_PER_DAY=200
AI_RATE_MAX_COMPANY_PER_HOUR=300

# Quota enforcement (false = do not block fresh installs by quota)
AI_QUOTA_ENABLED=false

# Provider model overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Provider health circuit-breaker
AI_HEALTH_MAX_FAILURES=3
AI_HEALTH_WINDOW=600

# NVIDIA (OpenAI-compatible)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# -----------------------------------------------------------------------------
# Optional integrations (leave blank if unused)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WHATSAPP_API_KEY=
# WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0

# -----------------------------------------------------------------------------
# Firebase (optional)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_AUTH_ENABLED=false
FIREBASE_FIRESTORE_ENABLED=false
FIREBASE_STORAGE_ENABLED=false
FIREBASE_MESSAGING_ENABLED=false
FIREBASE_ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# Security policy
# -----------------------------------------------------------------------------
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_PASSWORD_HISTORY=5
SECURITY_PASSWORD_EXPIRE_DAYS=90
SECURITY_PASSWORD_REVOKE_SESSIONS=true
SECURITY_LOCKDOWN_ACTIVE=false
# HTML needs Alpine's standard build (inline expressions); API responses never include unsafe-eval.
VENTUREX_CSP_ALLOW_UNSAFE_EVAL=true

# -----------------------------------------------------------------------------
# Login protection
# -----------------------------------------------------------------------------
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=5
SECURITY_LOGIN_LOCKOUT_THRESHOLD=8
SECURITY_LOGIN_LOCKOUT_MINUTES=15
SECURITY_LOGIN_ALERT_AFTER=10

# -----------------------------------------------------------------------------
# Demo mode (optional; used by application/demo seed flows if enabled)
# -----------------------------------------------------------------------------
# When true, the app may enable demo behaviors (see app/config and seeders). Default off.
DEMO_MODE=false
# Optional demo credentials used by some seeders (do not use real passwords in committed docs).
# DEMO_ADMIN_EMAIL=demo_admin@example.com
# DEMO_ADMIN_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Stripe billing (SERVER ONLY - leave blank until configured)
# -----------------------------------------------------------------------------
# Secret key, webhook signing secret and Price IDs belong on the server only.
# Never put a sk_/whsec_ value in Blade, JS, docs, git or the release ZIP.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_ENTITLEMENT_GRACE_DAYS=7
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
# Optional: where the Stripe Billing Portal returns the customer.
STRIPE_BILLING_PORTAL_RETURN_URL=

# Stripe Price IDs (not lookup keys) for purchasable add-on layers.
STRIPE_PRICE_UPDATES_SUPPORT=
STRIPE_PRICE_MANAGED_HOSTING=
STRIPE_PRICE_AI_CREDITS=
STRIPE_PRICE_REPORTING_PACK_ADV=
STRIPE_PRICE_WORKFLOW_AUTOMATION_PLUS=
STRIPE_PRICE_INTEGRATIONS_PRIORITY=
STRIPE_PRICE_MULTI_BRANCH_OPS=
STRIPE_PRICE_COMPLIANCE_HARDENING=
STRIPE_PRICE_GRANULAR_RBAC=
STRIPE_PRICE_SECURITY_PATCHES=
STRIPE_PRICE_CAPACITY_EXPANSION=
STRIPE_PRICE_LOGISTICS_SUITE_ADV=
STRIPE_PRICE_FINANCE_SUITE_ADV=
STRIPE_PRICE_PARTNER_WHITE_LABEL=
STRIPE_PRICE_CUSTOM_DEV_CREDITS=
STRIPE_PRICE_TPL_MANUFACTURING_PLUS=
STRIPE_PRICE_TPL_TRADING_DISTRIBUTION=
STRIPE_PRICE_TPL_SERVICES_PROJECTS=

# Stripe Price lookup keys are optional labels used in webhook metadata.
STRIPE_LOOKUP_GRANULAR_RBAC=
STRIPE_LOOKUP_SECURITY_PATCHES=
STRIPE_LOOKUP_CAPACITY_EXPANSION=
STRIPE_LOOKUP_TPL_MANUFACTURING_PLUS=
STRIPE_LOOKUP_TPL_TRADING_DISTRIBUTION=
STRIPE_LOOKUP_TPL_SERVICES_PROJECTS=

# -----------------------------------------------------------------------------
# License tokens (server-side only)
# -----------------------------------------------------------------------------
LICENSE_INSTALLATION_ID=
LICENSE_CUSTOMER_KEY=
LICENSE_ALLOW_UNBOUNDED_TOKENS=false
